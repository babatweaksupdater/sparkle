{
  "name": "sparkle",
  "version": "2.24.0",
  "description": "Baba Tweak",
  "main": "./out/main/index.js",
  "author": "Baba Tweak",
  "homepage": "https://github.com/",
  "repository": "",
  "scripts": {
    "release": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "discord-rpc-new": "^1.4.2",
    "electron-log": "^5.4.4",
    "electron-store": "8.1.0",
    "electron-updater": "^6.8.9",
    "systeminformation": "^5.32.0"
  },
  "devDependencies": {
    "electron": "43.1.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.parcoil.sparkle",
    "productName": "Baba Tweak",
    "executableName": "sparkle",
    "asar": true,
    "directories": { "output": "release" },
    "files": ["out/**/*", "tweaks/**/*", "package.json", "node_modules/**/*"],
    "extraResources": [
      { "from": "resources/elevate.exe", "to": "elevate.exe" },
      { "from": "resources/nvidiaProfileInspector.exe", "to": "nvidiaProfileInspector.exe" },
      { "from": "resources/sparkle2.ico", "to": "sparkle2.ico" },
      { "from": "resources/sparklenvidia.nip", "to": "sparklenvidia.nip" }
    ],
    "win": { "icon": "resources/sparkle2.ico", "target": ["nsis"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "deleteAppDataOnUninstall": false },
    "publish": [{ "provider": "github", "owner": "SET_BY_RELEASE_WORKFLOW", "repo": "SET_BY_RELEASE_WORKFLOW", "releaseType": "release" }]
  }
}
